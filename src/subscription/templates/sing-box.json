{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dns-local",
        "type": "local"
      },
      {
        "tag": "dns-cn",
        "type": "https",
        "server": "223.5.5.5"
      },
      {
        "tag": "dns-cn-doh",
        "type": "https",
        "server": "doh.pub",
        "domain_resolver": "dns-cn"
      },
      {
        "tag": "dns-remote",
        "type": "https",
        "server": "1.1.1.1",
        "detour": "代理"
      },
      {
        "tag": "dns-fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/16"
      }
    ],
    "rules": [
      {
        "domain_suffix": [
          "lan",
          "local",
          "home.arpa",
          "in-addr.arpa",
          "ip6.arpa"
        ],
        "server": "dns-local"
      },
      {
        "rule_set": [
          "geosite-private"
        ],
        "server": "dns-local"
      },
      {
        "domain_suffix": [
          "msftconnecttest.com",
          "msftncsi.com",
          "captive.apple.com",
          "connectivitycheck.gstatic.com",
          "detectportal.firefox.com",
          "connectivity-check.ubuntu.com",
          "networkcheck.kde.org",
          "time.windows.com",
          "time.apple.com",
          "time.android.com",
          "ntp.org"
        ],
        "server": "dns-cn"
      },
      {
        "domain_regex": [
          "(^|\\.)stun\\.[^.]+\\.[^.]+$"
        ],
        "server": "dns-cn"
      },
      {
        "rule_set": [
          "geosite-cn"
        ],
        "server": "dns-cn"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "dns-fakeip"
      }
    ],
    "final": "dns-remote",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "singbox-tun",
      "address": [
        "172.18.0.1/30"
      ],
      "mtu": 1400,
      "auto_route": true,
      "strict_route": true,
      "route_exclude_address": [],
      "stack": "mixed"
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7890
    },
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "listen_port": 7891
    },
    {
      "type": "http",
      "tag": "http-in",
      "listen": "127.0.0.1",
      "listen_port": 7892
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "代理",
      "outbounds": [
        "node-01-vless-reality",
        "node-02-vmess-ws",
        "node-03-hysteria2",
        "node-04-tuic",
        "自动选择",
        "DIRECT"
      ]
    },
    {
      "type": "urltest",
      "tag": "自动选择",
      "outbounds": [
        "node-01-vless-reality",
        "node-02-vmess-ws",
        "node-03-hysteria2",
        "node-04-tuic"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "5m",
      "tolerance": 50
    },
    {
      "type": "vless",
      "tag": "node-01-vless-reality",
      "server": "YOUR-SERVER.example.com",
      "server_port": 443,
      "uuid": "00000000-0000-0000-0000-000000000000",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "YOUR-CAMOUFLAGE.example.com",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        },
        "reality": {
          "enabled": true,
          "public_key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "short_id": "0123456789abcdef"
        }
      }
    },
    {
      "type": "vmess",
      "tag": "node-02-vmess-ws",
      "server": "YOUR-SERVER.example.com",
      "server_port": 443,
      "uuid": "00000000-0000-0000-0000-000000000000",
      "security": "auto",
      "alter_id": 0,
      "tls": {
        "enabled": true,
        "server_name": "YOUR-SNI.example.com"
      },
      "transport": {
        "type": "ws",
        "path": "/YOUR-WS-PATH",
        "headers": {
          "Host": "YOUR-SNI.example.com"
        }
      }
    },
    {
      "type": "hysteria2",
      "tag": "node-03-hysteria2",
      "server": "YOUR-SERVER.example.com",
      "server_port": 443,
      "password": "YOUR-PASSWORD",
      "tls": {
        "enabled": true,
        "server_name": "YOUR-SNI.example.com"
      },
      "up_mbps": 50,
      "down_mbps": 200
    },
    {
      "type": "tuic",
      "tag": "node-04-tuic",
      "server": "YOUR-SERVER.example.com",
      "server_port": 443,
      "uuid": "00000000-0000-0000-0000-000000000000",
      "password": "YOUR-PASSWORD",
      "congestion_control": "bbr",
      "tls": {
        "enabled": true,
        "server_name": "YOUR-SNI.example.com",
        "alpn": [
          "h3"
        ]
      }
    },
    {
      "type": "direct",
      "tag": "DIRECT"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "final": "代理",
    "default_domain_resolver": {
      "server": "dns-cn",
      "strategy": "ipv4_only"
    },
    "rules": [
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "domain_suffix": [
              "msftconnecttest.com",
              "msftncsi.com",
              "captive.apple.com",
              "connectivitycheck.gstatic.com",
              "detectportal.firefox.com",
              "connectivity-check.ubuntu.com",
              "networkcheck.kde.org",
              "push.apple.com"
            ],
            "invert": true
          },
          {
            "ip_cidr": [
              "91.105.192.0/23",
              "91.108.4.0/22",
              "91.108.8.0/21",
              "91.108.16.0/21",
              "91.108.56.0/22",
              "95.161.64.0/20",
              "149.154.160.0/20",
              "185.76.151.0/24"
            ],
            "invert": true
          },
          {
            "port": [
              80,
              8080,
              443,
              8443
            ]
          }
        ],
        "action": "sniff",
        "sniffer": [
          "http",
          "tls",
          "quic"
        ]
      },
      {
        "domain": [
          "services.googleapis.cn"
        ],
        "outbound": "代理"
      },
      {
        "domain_suffix": [
          "msftconnecttest.com",
          "msftncsi.com",
          "captive.apple.com",
          "connectivitycheck.gstatic.com",
          "detectportal.firefox.com",
          "connectivity-check.ubuntu.com",
          "networkcheck.kde.org"
        ],
        "outbound": "DIRECT"
      },
      {
        "domain_suffix": [
          "chatgpt.com",
          "openai.com",
          "oaistatic.com",
          "oaiusercontent.com",
          "x.com",
          "twitter.com",
          "twimg.com"
        ],
        "outbound": "代理"
      },
      {
        "domain_suffix": [
          "lan",
          "local",
          "home.arpa"
        ],
        "outbound": "DIRECT"
      },
      {
        "rule_set": [
          "geosite-private"
        ],
        "outbound": "DIRECT"
      },
      {
        "rule_set": [
          "geosite-cn"
        ],
        "outbound": "DIRECT"
      },
      {
        "rule_set": [
          "geoip-private"
        ],
        "outbound": "DIRECT"
      },
      {
        "rule_set": [
          "geoip-cn"
        ],
        "outbound": "DIRECT"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "geosite-cn",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-cn.srs",
        "download_detour": "DIRECT",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geosite-private",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-private.srs",
        "download_detour": "DIRECT",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geoip@rule-set/geoip-cn.srs",
        "download_detour": "DIRECT",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geoip-private",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geoip@rule-set/geoip-private.srs",
        "download_detour": "DIRECT",
        "update_interval": "1d"
      }
    ]
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090"
    }
  }
}
