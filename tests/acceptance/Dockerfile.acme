ARG BASE_IMAGE=sbctl-acceptance-debian-12-slim
FROM ${BASE_IMAGE}
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends certbot \
    && rm -rf /var/lib/apt/lists/*
COPY tests/acceptance/verify-acme.sh /usr/local/lib/sbctl-acceptance/verify-acme.sh
RUN sed -i 's/\r$//' /usr/local/lib/sbctl-acceptance/verify-acme.sh \
    && chmod 0755 /usr/local/lib/sbctl-acceptance/verify-acme.sh
